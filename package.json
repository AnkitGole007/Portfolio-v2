{
  "name": "ankitgole-portfolio",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/sync-github.mjs && node scripts/check-profile.mjs && node scripts/build-markdown.mjs",
    "build": "next build",
    "postbuild": "node scripts/scan-build.mjs && node scripts/check-identity.mjs --build",
    "start": "next start",
    "check": "node scripts/check-profile.mjs && node scripts/check-profile.mjs scripts/fixtures/profile-banned.json --expect-fail \"0.85 F1\" && node scripts/check-links.mjs --self-test && node scripts/scan-build.mjs --self-test",
    "check:links": "node scripts/check-links.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "clsx": "^2.1.1",
    "motion": "^12.43.0",
    "next": "^16.4.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-use-measure": "^2.1.7",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  }
}
